{
  "name": "nexa-mail",
  "version": "0.1.0",
  "private": true,
  "description": "Nexa Mail: a simple text-only mail service for Nexa users (name@nexa.com), stored in MongoDB.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "10.4.4",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.4",
    "@nestjs/mongoose": "10.0.10",
    "@nestjs/platform-express": "10.4.4",
    "dotenv": "16.4.5",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.5.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.11",
    "typescript": "5.5.4"
  }
}
