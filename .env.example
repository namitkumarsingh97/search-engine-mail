# --- Required ---------------------------------------------------------------
# The SAME database the Nexa API uses (this service reads the users collection and keeps mail in its own collections).
MONGODB_URI=

# The SAME secret the Nexa API signs login tokens with. This service only checks tokens; it never makes them.
JWT_SECRET=

# --- Optional ---------------------------------------------------------------
# Browser origins allowed to call this service, comma separated (the main UI).
CORS_ORIGIN=http://localhost:3000

# The part after @ in Nexa addresses. A label inside Nexa: nothing is sent to this domain on the internet.
MAIL_DOMAIN=nexa.com

# Address of the main UI, used for the link in the welcome mail (leave empty to omit the link).
APP_URL=

# Sends/draft saves allowed per user per hour. Default 150.
SEND_LIMIT_PER_HOUR=150

PORT=4200
